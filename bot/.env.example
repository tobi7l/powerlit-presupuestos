# Copiar a ".env" en el servidor y completar. Nunca subir el ".env" real a git
# (el repositorio es público).

# Token que te dio @BotFather al crear el bot con /newbot
TELEGRAM_BOT_TOKEN=

# IDs de chat de Telegram con permiso para pedirle presupuestos al bot, separados por
# coma. Sin esto, cualquiera que encuentre el bot podría generar presupuestos con los
# descuentos reales de tus clientes. Para saber tu chat id: hablale a @userinfobot en
# Telegram, te lo muestra al toque.
TELEGRAM_ALLOWED_CHAT_IDS=

# ID del archivo clientes.json dentro de "Powerlit App" en Google Drive (para leer
# nombre/dirección/descuentos). Se saca de la URL al abrir el archivo en Drive:
# https://drive.google.com/file/d/ESTE_ES_EL_ID/view
DRIVE_CLIENTES_FILE_ID=

# ID de la carpeta de Drive donde ya se guardan los presupuestos (la misma que usa la
# app de escritorio, "Presupuestos"), para que el bot deje ahí también una copia del
# PDF que genera. Se saca de la URL al abrir la carpeta en Drive. Opcional: si se deja
# vacío, el bot solo manda el PDF por Telegram, sin guardar copia en Drive.
DRIVE_PRESUPUESTOS_FOLDER_ID=

# Ruta al archivo de clave de la cuenta de servicio de Google (JSON), la que tiene
# acceso a la carpeta "Powerlit App" y a la carpeta de Presupuestos en Drive (hay que
# compartir esas carpetas con el mail de la cuenta de servicio, como a cualquier
# colaborador). Ver bot/README.md para cómo generarla.
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
